{
  "name": "ADMS",
  "fullName": "ActiveIO Data Management System",
  "description": "企业级数据中心运维管理系统，支持数据库检测、文件安全检测、备份恢复等功能",
  "version": "2.0.0",
  "techStack": {
    "framework": "Spring Boot 3.1.6",
    "web": "Spring WebFlux",
    "orm": "Spring Data JPA",
    "database": "PostgreSQL",
    "cache": "Redis (Redisson 3.24.2)",
    "mq": "RocketMQ 2.3.1",
    "netty": "Netty 4.1.128.Final",
    "job": "XXL-Job 3.1.1"
  },
  "layers": [
    {
      "id": "presentation",
      "name": "表现层",
      "alias": "Presentation Layer",
      "description": "提供 RESTful API 接口，处理 HTTP 请求和响应",
      "source": "adms-api/src/main/java/com/activeio/adms/controller/",
      "technology": "Spring WebFlux (响应式 Web 框架)",
      "nodes": [
        {
          "id": "drs-controller",
          "name": "DatabaseDetectionController",
          "displayName": "数据库检测 API",
          "source": "controller/drs/",
          "description": "数据库检测 REST API，支持静态检测、快速检测、深度检测、随机检测四种模式",
          "functions": [
            "创建检测作业",
            "查询检测结果",
            "导出检测报告",
            "检测周期管理"
          ],
          "endpoints": ["/api/drs/detection", "/api/drs/job", "/api/drs/detail"]
        },
        {
          "id": "frs-controller",
          "name": "FrsController",
          "displayName": "文件安全检测 API",
          "source": "controller/frs/",
          "description": "文件安全检测 REST API，提供文件完整性检查和权限检查",
          "functions": [
            "创建文件检测作业",
            "查询检测结果",
            "白名单管理"
          ],
          "endpoints": ["/api/frs", "/api/frs/job", "/api/frs/check"]
        },
        {
          "id": "mdm-host-controller",
          "name": "MdmHostController",
          "displayName": "主机管理 API",
          "source": "controller/mdm/MdmHostController.java",
          "description": "主机数据管理 REST API，管理数据中心服务器资产",
          "functions": [
            "主机注册",
            "主机信息查询",
            "主机状态监控",
            "主机批量导入"
          ],
          "endpoints": ["/api/mdm/host"]
        },
        {
          "id": "mdm-application-controller",
          "name": "MdmApplicationController",
          "displayName": "应用管理 API",
          "source": "controller/mdm/MdmApplicationController.java",
          "description": "应用管理 REST API，管理数据库应用和文件系统应用",
          "functions": [
            "应用注册",
            "应用配置管理",
            "应用状态查询",
            "应用批量导入"
          ],
          "endpoints": ["/api/mdm/application"]
        },
        {
          "id": "mdm-topology-controller",
          "name": "MdmTopologyController",
          "displayName": "拓扑管理 API",
          "source": "controller/mdm/MdmTopologyController.java",
          "description": "拓扑管理 REST API，管理应用拓扑关系",
          "functions": [
            "拓扑图展示",
            "拓扑关系编辑"
          ],
          "endpoints": ["/api/mdm/topology"]
        },
        {
          "id": "user-controller",
          "name": "UserController",
          "displayName": "用户管理 API",
          "source": "controller/permission/UserController.java",
          "description": "用户管理 REST API",
          "functions": [
            "用户 CRUD",
            "用户角色分配",
            "用户组织分配",
            "密码管理"
          ],
          "endpoints": ["/api/permission/user"]
        },
        {
          "id": "role-controller",
          "name": "RoleController",
          "displayName": "角色管理 API",
          "source": "controller/permission/RoleController.java",
          "description": "角色管理 REST API",
          "functions": [
            "角色 CRUD",
            "角色权限分配",
            "角色菜单分配"
          ],
          "endpoints": ["/api/permission/role"]
        },
        {
          "id": "organization-controller",
          "name": "OrganizationController",
          "displayName": "组织管理 API",
          "source": "controller/permission/OrganizationController.java",
          "description": "组织管理 REST API",
          "functions": [
            "组织树管理",
            "组织资源池分配"
          ],
          "endpoints": ["/api/permission/organization"]
        },
        {
          "id": "menu-controller",
          "name": "MenuController",
          "displayName": "菜单管理 API",
          "source": "controller/permission/MenuController.java",
          "description": "菜单管理 REST API",
          "functions": [
            "菜单树管理",
            "菜单操作配置"
          ],
          "endpoints": ["/api/permission/menu"]
        },
        {
          "id": "auth-controller",
          "name": "AuthController",
          "displayName": "认证授权 API",
          "source": "controller/permission/AuthController.java",
          "description": "认证授权 REST API",
          "functions": [
            "用户登录",
            "Token 刷新",
            "权限验证"
          ],
          "endpoints": ["/api/auth/login", "/api/auth/refresh"]
        },
        {
          "id": "bav-controller",
          "name": "BavController",
          "displayName": "备份验证 API",
          "source": "controller/bav/",
          "description": "备份验证 REST API",
          "functions": [
            "创建验证作业",
            "查询验证结果"
          ],
          "endpoints": ["/api/bav"]
        },
        {
          "id": "srs-controller",
          "name": "SrsController",
          "displayName": "存储恢复 API",
          "source": "controller/srs/",
          "description": "存储恢复 REST API",
          "functions": [
            "创建恢复作业",
            "查询恢复状态"
          ],
          "endpoints": ["/api/srs"]
        },
        {
          "id": "policy-controller",
          "name": "PolicyController",
          "displayName": "策略管理 API",
          "source": "controller/policy/PolicyController.java",
          "description": "策略管理 REST API",
          "functions": [
            "策略 CRUD",
            "策略应用"
          ],
          "endpoints": ["/api/policy"]
        },
        {
          "id": "engine-controller",
          "name": "EngineController",
          "displayName": "引擎管理 API",
          "source": "controller/engine/",
          "description": "引擎管理 REST API",
          "functions": [
            "引擎状态查询",
            "镜像管理",
            "资源管理"
          ],
          "endpoints": ["/api/engine"]
        },
        {
          "id": "admc-controller",
          "name": "AdmcController",
          "displayName": "客户端通信 API",
          "source": "controller/admc/",
          "description": "ADMC 客户端通信 REST API",
          "functions": [
            "客户端注册",
            "客户端状态查询",
            "文件传输"
          ],
          "endpoints": ["/api/admc"]
        },
        {
          "id": "dashboard-controller",
          "name": "DashbordController",
          "displayName": "仪表盘 API",
          "source": "controller/dashbord/",
          "description": "仪表盘 REST API，提供多种视图的数据聚合",
          "functions": [
            "管理员看板",
            "业务看板",
            "高管看板",
            "概览统计"
          ],
          "endpoints": ["/api/dashboard"]
        },
        {
          "id": "email-controller",
          "name": "EmailController",
          "displayName": "邮件配置 API",
          "source": "controller/email/",
          "description": "邮件配置 REST API",
          "functions": [
            "邮件服务器配置",
            "邮件模板管理",
            "邮件发送"
          ],
          "endpoints": ["/api/email"]
        },
        {
          "id": "license-controller",
          "name": "LicenseController",
          "displayName": "许可证 API",
          "source": "controller/license/LicenseController.java",
          "description": "许可证管理 REST API",
          "functions": [
            "许可证验证",
            "许可证信息查询"
          ],
          "endpoints": ["/api/license"]
        }
      ]
    },
    {
      "id": "service",
      "name": "业务服务层",
      "alias": "Service Layer",
      "description": "实现核心业务逻辑，协调各组件完成业务流程",
      "source": "adms-api/src/main/java/com/activeio/adms/service/",
      "technology": "Spring Boot 3.1.6, MapStruct",
      "nodes": [
        {
          "id": "drs-service",
          "name": "DatabaseDetectionService",
          "displayName": "数据库检测服务",
          "source": "service/drs/",
          "description": "数据库检测核心逻辑，编排检测流程，支持多种数据库类型",
          "functions": [
            "静态检测：检测数据库配置合规性",
            "快速检测：快速扫描数据库状态",
