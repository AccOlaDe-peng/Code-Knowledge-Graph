      {
        "name": "检测作业执行流",
        "path": ["Controller", "Service", "FlowEngine", "NettyServer", "ADMC Client", "Database"]
      },
      {
        "name": "心跳检测流",
        "path": ["ADMC Client", "NettyServer", "HeartbeatHandler", "Redis"]
      },
      {
        "name": "异步消息流",
        "path": ["Service", "ExecutionProducer", "RocketMQ", "ExecutionConsumer", "Task"]
      }
    ]
