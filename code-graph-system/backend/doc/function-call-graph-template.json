{
  "_template": {
    "description": "函数调用关系图 JSON 模板 - 适用于任何编程语言的项目",
    "version": "1.0.0",
    "usage": "复制此模板，替换项目实际数据"
  },

  "projectName": "${PROJECT_NAME}",
  "version": "${PROJECT_VERSION}",
  "generatedAt": "${GENERATED_TIMESTAMP}",
  "generator": {
    "name": "${GENERATOR_NAME}",
    "version": "${GENERATOR_VERSION}"
  },

  "statistics": {
    "totalModules": 0,
    "totalFunctions": 0,
    "totalCallChains": 0,
    "totalCrossModuleCalls": 0
  },

  "config": {
    "excludedModules": [],
    "excludedPackages": [],
    "excludedPatterns": [],
    "includedPatterns": ["**/*.java", "**/*.kt", "**/*.py", "**/*.ts", "**/*.js", "**/*.go"],
    "analysisDepth": 10,
    "language": "java"
  },

  "modules": [
    {
      "id": "mod_000",
      "name": "${MODULE_NAME}",
      "displayName": "${MODULE_DISPLAY_NAME}",
      "description": "${MODULE_DESCRIPTION}",
      "path": "${MODULE_PATH}",
      "language": "${LANGUAGE}",
      "functionCount": 0,
      "callChainCount": 0,
      "functions": [
        {
          "id": "func_000000",
          "name": "${FUNCTION_NAME}",
          "className": "${CLASS_NAME}",
          "fullName": "${FULL_QUALIFIED_NAME}",
          "type": "service|controller|repository|entity|util|config|unknown",
          "visibility": "public|private|protected|package",
          "description": "${FUNCTION_DESCRIPTION}",
          "sourceFile": "${SOURCE_FILE_PATH}",
          "sourceLine": 0,
          "params": [
            {
              "name": "${PARAM_NAME}",
              "type": "${PARAM_TYPE}",
              "description": "${PARAM_DESCRIPTION}"
            }
          ],
          "returnType": {
            "type": "${RETURN_TYPE}",
            "description": "${RETURN_DESCRIPTION}"
          },
          "annotations": [
            {
              "name": "${ANNOTATION_NAME}",
              "params": {}
            }
          ],
          "callerCount": 0,
          "calleeCount": 0,
          "static": false,
          "deprecated": false
        }
      ],
      "internalCallChains": [
        {
          "callerId": "func_000000",
          "callerName": "${CALLER_FULL_NAME}",
          "calleeId": "func_000001",
          "calleeName": "${CALLEE_FULL_NAME}",
          "callType": "direct|virtual|interface|lambda|reflection",
          "sourceLine": 0
        }
      ]
    }
  ],

  "crossModuleCalls": [
    {
      "sourceModule": "${SOURCE_MODULE_NAME}",
      "sourceModuleId": "mod_000",
      "sourceFunctionId": "func_000000",
      "sourceFunctionName": "${SOURCE_FUNCTION_FULL_NAME}",
      "targetModule": "${TARGET_MODULE_NAME}",
      "targetModuleId": "mod_001",
      "targetFunctionId": "func_001000",
      "targetFunctionName": "${TARGET_FUNCTION_FULL_NAME}",
      "callType": "direct|virtual|interface|lambda|reflection",
      "sourceLine": 0
    }
  ],

  "metadata": {
    "projectRoot": "${PROJECT_ROOT_PATH}",
    "sourcePaths": ["src/main/java"],
    "buildTool": "gradle|maven|npm|pip|go mod|none",
    "framework": "spring boot|node.js|django|flask|gin|none"
  },

  "_fieldDefinitions": {
    "projectName": "项目名称",
    "version": "项目版本号",
    "generatedAt": "生成时间戳 (ISO 8601 格式)",
    "totalModules": "模块总数",
    "totalFunctions": "函数总数",
    "totalCallChains": "调用链总数",
    "excludedModules": "排除的模块列表",

    "module.id": "模块唯一标识 (格式: mod_XXX)",
    "module.name": "模块名称 (目录名)",
    "module.displayName": "模块显示名称 (中文描述)",
    "module.description": "模块功能描述",
    "module.path": "模块源码相对路径",
    "module.functionCount": "模块内函数数量",
    "module.callChainCount": "模块内调用链数量",

    "function.id": "函数唯一标识 (格式: func_XXXXXX)",
    "function.name": "函数名称",
    "function.className": "所属类名",
    "function.fullName": "完整限定名 (包名.类名.方法名)",
    "function.type": "函数类型: service(服务层) | controller(控制层) | repository(数据层) | entity(实体) | util(工具) | config(配置) | unknown",
    "function.visibility": "可见性: public | private | protected | package",
    "function.sourceFile": "源文件路径",
    "function.sourceLine": "函数定义起始行号",
    "function.callerCount": "被调用次数 (入度)",
    "function.calleeCount": "调用其他函数次数 (出度)",
    "function.static": "是否静态方法",

    "callChain.callerId": "调用方函数ID",
    "callChain.calleeId": "被调用方函数ID",
    "callChain.callType": "调用类型: direct(直接调用) | virtual(虚方法) | interface(接口调用) | lambda | reflection(反射)",

    "crossModuleCall": "跨模块调用关系，字段同 callChain，增加源模块和目标模块信息"
  },

  "_supportedLanguages": {
    "java": {
      "extensions": [".java"],
      "typeKeywords": ["class", "interface", "enum", "@interface"],
      "visibilityKeywords": ["public", "private", "protected"]
    },
    "kotlin": {
      "extensions": [".kt"],
      "typeKeywords": ["class", "interface", "object", "enum class"],
      "visibilityKeywords": ["public", "private", "protected", "internal"]
    },
    "python": {
      "extensions": [".py"],
      "typeKeywords": ["class", "def"],
      "visibilityKeywords": ["public", "_private", "__protected"]
    },
    "typescript": {
      "extensions": [".ts", ".tsx"],
      "typeKeywords": ["class", "interface", "type", "enum"],
      "visibilityKeywords": ["public", "private", "protected"]
    },
    "javascript": {
      "extensions": [".js", ".jsx"],
      "typeKeywords": ["class", "function"],
      "visibilityKeywords": ["export", "private"]
    },
    "go": {
      "extensions": [".go"],
      "typeKeywords": ["func", "type", "interface", "struct"],
      "visibilityKeywords": ["public", "private"]
    }
  }
}
