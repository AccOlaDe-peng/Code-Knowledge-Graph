        {
          "id": "repository-id",
          "name": "RepositoryClassName",
          "displayName": "数据访问显示名称",
          "source": "Repository 源码位置",
          "description": "数据访问描述",
          "functions": [
            "CRUD 操作",
            "自定义查询"
          ],
          "dependencies": ["database-id"]
        }
      ]
    },
    {
      "id": "infrastructure",
      "name": "基础设施层",
      "alias": "Infrastructure Layer",
      "description": "配置、安全、日志、缓存等基础设施",
      "source": "基础设施源码路径",
      "technology": "使用的技术",
