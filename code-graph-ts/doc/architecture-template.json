          "functions": [
            "功能1",
            "功能2",
            "功能3"
          ],
          "endpoints": ["/api/path1", "/api/path2"],
          "dependencies": ["dependency-id-1", "dependency-id-2"],
          "attributes": ["属性1", "属性2"]
        }
      ]
    },
    {
      "id": "service",
      "name": "业务服务层",
      "alias": "Service Layer",
