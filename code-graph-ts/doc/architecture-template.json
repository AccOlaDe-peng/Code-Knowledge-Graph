  "externalIntegrations": {
    "description": "外部系统集成（可选）",
    "integrations": [
      {
        "name": "集成名称",
        "type": "集成类型",
        "protocol": "通信协议",
        "description": "集成描述"
      }
    ]
  },

  "supportedFeatures": {
    "description": "支持的功能特性列表（可选，根据项目需要调整字段名）",
