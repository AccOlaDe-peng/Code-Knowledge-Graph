          "id": "config-id",
          "name": "ConfigClassName",
          "displayName": "配置显示名称",
          "source": "配置源码位置",
          "description": "配置描述",
          "functions": [
            "配置功能1"
          ],
          "dependencies": []
        }
      ]
    },
    {
      "id": "data",
      "name": "数据存储层",
      "alias": "Data Layer",
      "description": "外部数据存储系统",
      "source": "外部依赖",
      "technology": "数据库技术",
      "nodes": [
        {
          "id": "database-id",
          "name": "DatabaseName",
          "displayName": "数据库显示名称",
          "source": "外部依赖",
          "description": "数据库描述",
          "functions": [
            "数据存储",
            "数据查询"
          ],
          "attributes": ["特性1", "特性2"]
        }
      ]
    }
