          "description": "实体描述",
          "functions": [
            "实体功能1"
          ],
          "attributes": ["字段1", "字段2", "字段3"]
        }
      ]
    },
    {
      "id": "repository",
      "name": "数据访问层",
      "alias": "Repository Layer",
